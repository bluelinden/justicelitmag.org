---
import { ClientRouter } from 'astro:transitions';
import { SEO } from 'astro-seo';
// import '@fontsource/figtree';
// import '@fontsource/rokkitt';
import '@fontsource/young-serif';

interface Props {
	title: string;
	slug?: string;
}

const { title, slug } = Astro.props;
---

<!doctype html>
<html lang="en" class="min-h-screen bg-lmp-100 font-serif text-lmp-900 max-w-screen mr-0">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Astro description" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<!-- <script
			defer
			data-domain="justicelitmag.org"
			src="https://analytics.bluelinden.art/js/script.js"></script> -->

		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Material+Symbols+Rounded:opsz,wght,FILL,GRAD@20..48,700,0,0"
		/>

		<ClientRouter />
		<SEO
			{title}
			titleTemplate={'%s - Justice Lit Mag'}
			charset="UTF-8"
			openGraph={{
				basic: {
					title: 'The Justice Literature and Arts Magazine',
					type: 'website',
					image: '/seo/litmag-2024a-refresh.jpg'
				}
			}}
		/>
	</head>
	<body class="min-h-screen transition-colors duration-500" transition:animate="fade" }>
		<slot />
	</body>
</html>
