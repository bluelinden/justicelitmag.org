---
const { name, slug, works, position } = Astro.props;
import { getEntries } from 'astro:content';

import Layout from './Layout.astro';
import type { getCollection } from 'astro:content';

const workPages = works.map(()=> {
  
})

const worksData = (await getEntries(works ?? [])) ?? [];

---

<Layout title={`${name} in the Justice Lit Mag`} slug={slug}>
	<div class="flex h-[calc(100vh-4rem)] flex-row flex-wrap content-center justify-center">
		<main
			class="h-96 w-full rounded-4xl border-[6px] border-lmp-900 bg-lmp-100 drop-shadow-2xl sm:w-96"
		>
			<div class="border-b-[6px] border-lmp-900 p-4 pt-5">
				<h1 class="text-4xl">{name}</h1>
				{
					position && (
						<div class="flex flex-row items-center text-xl lg:text-2xl gap-2">
							<span class="material-symbols-rounded text-xl lg:text-2xl mb-px">star</span>
							{position}
						</div>
					)
				}
				
			</div>
		</main>
	</div>
</Layout>
