<style is:global>
	aside a {
		text-decoration: underline;
		text-underline-offset: 0.2rem;
		text-decoration-thickness: 3px;
	}
	:root {
		--md-ref-typeface-brand: 'Figtree';
		--md-ref-typeface-plain: 'Figtree';
	}
</style>
